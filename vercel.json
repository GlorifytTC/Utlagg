{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["arn1"],
  "functions": {
    "app/api/ocr/route.ts": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/reset-scans", "schedule": "0 0 1 * *" },
    { "path": "/api/cron/vest-referrals", "schedule": "0 2 * * *" },
    { "path": "/api/cron/trial-maintenance", "schedule": "0 4 * * *" },
    { "path": "/api/cron/archive-audit", "schedule": "0 3 * * 0" }
  ]
}
