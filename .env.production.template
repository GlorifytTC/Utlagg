# ---------------------------------------------------------------------------
# Kvitto — production environment template
# Copy the relevant values into Railway (DB service) and Vercel (app).
# NEVER commit the filled-in version. .env*.local and .env are gitignored.
# ---------------------------------------------------------------------------

# --- Required (app will not work without these) ---

# From Railway Postgres -> "Connect" tab. Use the public TCP proxy URL
# (RAILWAY_TCP_PROXY_DOMAIN) when connecting from Vercel; the *.railway.internal
# host only resolves inside Railway's private network.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# drizzle-kit push uses DIRECT_URL if set; point it at the same DB (a non-pooled
# connection is preferred for migrations).
DIRECT_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your stable production URL (NOT a per-deploy preview URL). e.g. https://kvitto.se
NEXTAUTH_URL=https://your-domain.vercel.app

STRIPE_SECRET_KEY=sk_live_xxx            # sk_test_xxx while testing
STRIPE_WEBHOOK_SECRET=whsec_xxx          # from `stripe listen` or the dashboard endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_PRICE_PRO=price_xxx               # 149 kr/mo recurring price ID
STRIPE_PRICE_FORETAG=price_yyy           # 299 kr/mo recurring price ID

# --- Optional (features degrade gracefully until set) ---

GOOGLE_CLOUD_API_KEY=                    # enables real OCR; without it /api/ocr returns 502
BANKID_API_KEY=                          # phase 2; /api/bankid/auth is a 501 stub until then

# --- Phase 3: storage, BankID, rate limiting, cron, Fortnox ---

# Cloudflare R2 (EU jurisdiction for GDPR). Bucket stays PRIVATE; we serve
# receipts via short-lived presigned URLs, never public links.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kvitto-receipts

# BankID (mutual TLS — NOT a bearer key). Base64-encode the bank-issued files.
BANKID_ENV=test                          # "production" when live
BANKID_P12_BASE64=                        # base64 of your RP client cert (.p12)
BANKID_P12_PASSPHRASE=
BANKID_CA_BASE64=                         # base64 of the BankID CA chain (PEM)

# Upstash Redis (rate limiting). If unset, rate limiting is disabled, not fatal.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron auth (Vercel Cron sends this as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=                              # openssl rand -base64 32

# Fortnox OAuth2
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=https://your-domain.vercel.app/api/integrations/fortnox/callback

# --- Phase 6/7: email, queue, encryption, monitoring ---

# Resend (transactional email). Unset = email sends are skipped (not fatal).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Utlagg <noreply@utlagg.se>

# Upstash QStash (optional background OCR queue)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# AES-256-GCM key for encrypting sensitive values. openssl rand -hex 32
ENCRYPTION_SECRET=

# Structured logging level: debug | info | warn | error
LOG_LEVEL=info

# --- Admin panel ---
# Comma-separated allowlist of admin emails. Gating /admin by the role column is
# NOT safe (role defaults to 'admin' for everyone). Use this instead.
ADMIN_EMAILS=admin@utlagg.se
