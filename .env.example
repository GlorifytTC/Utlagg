# ---- Database (Railway) ----
# Pooled connection used by the running app
DATABASE_URL=postgresql://user:pass@host:port/db
# Direct connection used by drizzle-kit migrations
DIRECT_URL=postgresql://user:pass@host:port/db

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000

# ---- OCR (Google Cloud Vision) ----
GOOGLE_CLOUD_API_KEY=

# ---- Stripe (SEK) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs created in the Stripe dashboard (recurring, currency = sek)
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_FORETAG=price_xxx

# ---- BankID (phase 2 — stub only for now) ----
BANKID_API_KEY=
