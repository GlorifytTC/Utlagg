# ---- Database (Railway) ----
# Pooled connection used by the running app
DATABASE_URL=postgresql://user:pass@host:port/db
# Direct connection used by drizzle-kit migrations
DIRECT_URL=postgresql://user:pass@host:port/db

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000

# ---- OCR (Google Cloud Vision) ----
GOOGLE_CLOUD_API_KEY=

# ---- Stripe (SEK) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs. Create them idempotently with: npm run stripe:setup
# (recurring, currency = sek). Then paste the printed IDs here.
# Starter (100 scans / 50 kr) — recurring
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_FORETAG=price_xxx
STRIPE_PRICE_MAX=price_xxx
# One-off credit pack (100 scans / 50 kr) — mode: payment
STRIPE_PRICE_CREDIT_PACK=price_xxx
# Set to "true" only after enabling Stripe Tax in the dashboard.
STRIPE_TAX_ENABLED=false

# ---- Pricing V2 + referrals (feature-flagged rollout) ----
# Master switch for metered scan caps, overage, credit packs and referral
# rewards. Leave off until the Stripe prices above exist. Existing users are
# unaffected when this is off.
PRICING_V2_ENABLED=false
# Referral tuning (optional — sane defaults in lib/billing/config.ts)
REFERRAL_HOLD_DAYS=30
REFERRAL_REWARD_DAYS=14
REFERRAL_MONTHLY_CAP=5
REFERRAL_ANNUAL_CAP=50
REFERRAL_NEW_USER_BONUS_ENABLED=false

# ---- Pricing V3: Trial + Starter + export gating + trial guard ----
# Independently toggleable/rollback-able flags (spec §0). PRICING_V3_ENABLED is
# the master switch; when off, none of the trial / read-only / Starter logic
# takes effect and the app behaves exactly as V2.
PRICING_V3_ENABLED=false
EXPORT_GATING_ENABLED=false
TRIAL_EMAIL_GUARD_ENABLED=false
# Card-required trial (default true). "false" = no-card variant (still expires
# to read-only lockout, never to reusable free scans).
TRIAL_REQUIRE_CARD=true
# Trial shape (optional — defaults in lib/billing/config.ts).
TRIAL_DAYS=30
TRIAL_SCANS=500
# Repeat-trial email guard (spec §E). STABLE server-side HMAC secret — rotating
# it invalidates every stored token. Generate with: openssl rand -base64 32
# NEVER commit the real value. Retention MUST match ToS/Privacy clause F.5 (24).
TRIAL_GUARD_HMAC_SECRET=replace-me
TRIAL_GUARD_RETENTION_MONTHS=24

# ---- Cron (monthly reset / overage close-out / referral vesting /
#      trial expiry + trial-guard purge) ----
CRON_SECRET=

# ---- BankID (phase 2 — stub only for now) ----
BANKID_API_KEY=
