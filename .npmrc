# next-auth v4 declares an OPTIONAL peer on nodemailer ^7, but this app does not
# use next-auth's Email provider - it uses credentials auth and calls nodemailer
# directly. nodemailer is pinned to v10 to fix SMTP/CRLF injection advisories.
# legacy-peer-deps lets npm install that combination instead of erroring on the
# optional peer. Applies to local installs and the Vercel build.
legacy-peer-deps=true
